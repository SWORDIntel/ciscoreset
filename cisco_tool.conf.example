# Example configuration file for the Cisco Advanced Recovery Tool
# Copy this to /etc/cisco_tool.conf and uncomment/modify the variables you wish to override.

# --- General Settings ---
# Default timeout for operations in seconds
# TIMEOUT_DEFAULT=300

# Directory for session logs
# SESSION_LOG_DIR="/var/log/cisco_tool_sessions"

# --- Serial Configuration ---
# You can add or modify the baud rates to be tested by the auto-detection routine.
# BAUD_RATES=(9600 115200)

# --- JTAG Configuration ---
# Add custom TAP IDs for different hardware.
# Note: This will merge with the built-in list.
# declare -A CUSTOM_TAP_IDS=(
#     ["0xDEADBEEF"]="Custom MIPS Processor"
# )

# --- Logging ---
# Set to "true" to disable logging of command/response data to the session file.
# Useful for screen-only interaction.
# DISABLE_SESSION_LOGGING="false"
